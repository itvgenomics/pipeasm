#!/bin/bash

#PBS -l nodes=1:ncpus=<threads>
#PBS -N pipeasm
#PBS -o pipeasm.log
#PBS -e pipeasm.err

CORES=$[ `cat $PBS_NODEFILE | wc -l` ]
NODES=$[ `uniq $PBS_NODEFILE | wc -l` ]

printf "Begin: `date`\n";
TBEGIN=`echo "print time();" | perl`

printf "\n"
printf "> Running with $CORES cores, in $NODES nodes\n"

# Make sure to activate the conda environment with Snakemake and Singularity installed
source /mnt/gen/opt/softwares/miniconda3/etc/profile.d/conda.sh
conda activate snakemake2

cd $PBS_O_WORKDIR

# Example Singularity image directory to set in config.yaml (sif_dir): "/scratch/sif_files/pipeasm"
# Example FCS-GX database path to set in config.yaml (gxdb): "/mnt/gen/opt/utils/lucas/S4-Databases/fcs-gx_testDB/gxdb"
bash Pipeasm.sh -d . -c config/config.yaml -s workflow/Snakefile -t <threads>

TEND=`echo "print time();" | perl`

printf "\n"
printf "End: `date`\n";
printf "Run time (s): `expr $TEND - $TBEGIN`\n";
printf "Run time (min): `expr $(( ($TEND - $TBEGIN)/60 ))`\n";
